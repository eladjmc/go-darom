# Local development placeholders — copy to .env and fill. Never commit real secrets.

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://go_darom:go_darom_dev@localhost:5432/go_darom
POSTGRES_USER=go_darom
POSTGRES_PASSWORD=go_darom_dev
POSTGRES_DB=go_darom
POSTGRES_PORT=5432

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
APP_VERSION=0.2.0-m2

# Clerk (Google-only). Required for real auth.
CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=sk_test_S…rvJm
VITE_CLERK_PUBLISHABLE_KEY=

# Optional API base for web (empty = same-origin Vite proxy)
VITE_API_URL=

# Local-only identity stub when Clerk keys are not configured (never in production)
IDENTITY_DEV_STUB=false
VITE_IDENTITY_DEV_STUB=false

# Optional local bootstrap: comma-separated Clerk user ids (user_…) promoted to admin
# on authenticate (create or existing member). Clear after use. See docs/07-delivery/ADMIN_BOOTSTRAP.md
# Prefer: npm run bootstrap:admin -- --clerk-user-id user_xxx --i-understand
BOOTSTRAP_ADMIN_CLERK_IDS=

# Future adapters
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
